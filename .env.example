# Where the app reaches the API. Leave unset in development and it uses the machine
# running Metro on port 8000, which is what a phone on the same wifi needs.
EXPO_PUBLIC_API_URL=

# A default company code (P7). Crew normally pick their company on the company code screen,
# and that choice is sent as X-Tenant on every request. Set this (e.g. "demo", the seeded
# operator) to start on that company without the screen, in development or in a build made
# for one operator. Leave it unset to see the screen: preview and production builds do.
EXPO_PUBLIC_TENANT=
