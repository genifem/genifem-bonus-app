# Where the app reaches the API. Leave unset in development and it uses the machine
# running Metro on port 8000, which is what a phone on the same wifi needs.
EXPO_PUBLIC_API_URL=

# The operator this build belongs to, sent as X-Tenant on every request (plan D3: one
# operator, no pairing screen). Unset in development means "demo", the seeded tenant.
# A production build must set it: there is no fallback outside development.
EXPO_PUBLIC_TENANT=
